# ==============================================================================
# Server Environment Variables Configuration
# Copy this file to .env and replace the placeholder values with actual credentials.
# DO NOT commit real secrets or the .env file to version control.
# ==============================================================================

# Server Environment & Port
PORT=5001
NODE_ENV=production

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vehicle-tracking?retryWrites=true&w=majority

# Redis Cache Connection URI (Cloud or Local)
# Example local: redis://localhost:6379
# Example cloud: redis://default:<password>@<host>:<port>
REDIS_URI=redis://localhost:6379

# Clerk Authentication Keys (Backend)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Inngest Background Jobs & Webhook Sync
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key_here

# Client & CORS Configuration
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-production-client-domain.com
